<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- O mesmo núcleo do player de terminal: os arquivos são compartilhados, não copiados. -->
  <ItemGroup>
    <Compile Include="..\AsciiVideoPlayer\Ascii\*.cs" LinkBase="Nucleo\Ascii" />
    <Compile Include="..\AsciiVideoPlayer\Video\VideoFrame.cs" LinkBase="Nucleo\Video" />
    <Compile Include="..\AsciiVideoPlayer\Terminal\FrameLayout.cs" LinkBase="Nucleo\Terminal" />
    <Compile Include="..\AsciiVideoPlayer\Subtitles\SubtitleTrack.cs" LinkBase="Nucleo\Subtitles" />
    <Content Include="..\AsciiVideoPlayer\Export\desenho.js" Link="wwwroot\desenho.js" />
  </ItemGroup>

</Project>
